+/// PROTOTYPE SLICE7: every function in this file with a declared return
+/// type: (name, head identifier of the type, is array, line).
+fn return_index(fi: &FileInfo) -> Vec<(String, String, bool, usize)> {
+    let m = &fi.masked;
+    let all = tokens(m);
+    let t = Toks(&all);
+    let mut out = Vec::new();
+    for k in 0..all.len() {
+        if !(t.p(k, b')') && t.p(k + 1, b':')) {
+            continue;
+        }
+        let mut j = k + 2;
+        if t.is(j, "Promise") && t.p(j + 1, b'<') {
+            j += 2;
+        }
+        if t.is(j, "readonly") {
+            j += 1;
+        }
+        let mut arr = false;
+        if let Some(w) = t.id(j) {
+            if matches!(w, "Readonly" | "Partial" | "Required" | "Array" | "ReadonlyArray") && t.p(j + 1, b'<') {
+                arr = matches!(w, "Array" | "ReadonlyArray");
+                j += 2;
+            }
+        }
+        let Some(head) = t.id(j) else { continue };
+        if t.p(j + 1, b'.') {
+            continue;
+        }
+        let mut e = j + 1;
+        if t.p(e, b'<') {
+            e = t.skip_group(e, b'<', b'>');
+        }
+        if t.p(e, b'[') && t.p(e + 1, b']') {
+            arr = true;
+        }
+        let mut d = 0i32;
+        let mut o = k;
+        loop {
+            if t.p(o, b')') {
+                d += 1;
+            } else if t.p(o, b'(') {
+                d -= 1;
+                if d == 0 {
+                    break;
+                }
+            }
+            if o == 0 {
+                break;
+            }
+            o -= 1;
+        }
+        if o == 0 {
+            continue;
+        }
+        let name = match t.id(o - 1) {
+            Some("async") if o >= 3 && t.p(o - 2, b'=') => t.id(o - 3),
+            Some(n) if n != "function" => Some(n),
+            None if o >= 2 && t.p(o - 1, b'=') => t.id(o - 2),
+            _ => None,
+        };
+        if let Some(n) = name {
+            let line = m[..all[k].1].iter().filter(|&&b| b == b'\n').count() + 1;
+            out.push((n.to_string(), head.to_string(), arr, line));
+        }
+    }
+    out
+}
