+/// Field reads (name_key -> (spelling, first line)) whose receiver is
+/// declared as `shape` in this file; writes never count.
+fn receiver_reads(fi: &FileInfo, shape: &str) -> BTreeMap<String, (String, usize)> {
+    let m = &fi.masked;
+    let t = tokens(m);
+    let (one, arr) = receivers(&t, shape);
+    let mut out: BTreeMap<String, (String, usize)> = BTreeMap::new();
+    let line = |off: usize| m[..off].iter().filter(|&&b| b == b'\n').count() + 1;
+    let write_after = |k: usize| -> bool {
+        // token k is the field; a write follows?
+        let Some((_, off)) = t.get(k) else { return false };
+        let mut i = *off;
+        while i < m.len() && is_ident(m[i]) {
+            i += 1;
+        }
+        while i < m.len() && m[i].is_ascii_whitespace() {
+            i += 1;
+        }
+        let r = &m[i..m.len().min(i + 3)];
+        (r.first() == Some(&b'=') && !matches!(r.get(1), Some(b'=') | Some(b'>')))
+            || r.starts_with(b"+=") || r.starts_with(b"-=") || r.starts_with(b"*=") || r.starts_with(b"/=")
+            || r.starts_with(b"++") || r.starts_with(b"--") || r.starts_with(b"??=") || r.starts_with(b"||=") || r.starts_with(b"&&=")
+    };
+    for k in 0..t.len() {
+        let Some(r) = id_at(&t, k) else { continue };
+        let this_field = k >= 2 && is_p(&t, k - 1, b'.') && is_id(&t, k - 2, "this");
+        if k > 0 && is_p(&t, k - 1, b'.') && !this_field {
+            continue;
+        }
+        let mut j = k + 1;
+        if arr.contains(r) && is_p(&t, j, b'[') {
+            let mut d = 0i32;
+            while j < t.len() {
+                if is_p(&t, j, b'[') {
+                    d += 1;
+                } else if is_p(&t, j, b']') {
+                    d -= 1;
+                    if d == 0 {
+                        j += 1;
+                        break;
+                    }
+                }
+                j += 1;
+            }
+        } else if !one.contains(r) {
+            continue;
+        }
+        if is_p(&t, j, b'?') {
+            j += 1;
+        }
+        if !is_p(&t, j, b'.') {
+            continue;
+        }
+        if let Some(f) = id_at(&t, j + 1) {
+            if !write_after(j + 1) {
+                out.entry(name_key(f)).or_insert((f.to_string(), line(t[j + 1].1)));
+            }
+        }
+    }
+    out
+}
