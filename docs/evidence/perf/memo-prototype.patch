+// PERF prototype: per-process memo of pure text analyses, keyed by the
+// text's BLAKE3 (and the artifact name where the analysis depends on it).
+thread_local! {
+    static CODE_FIELDS: std::cell::RefCell<std::collections::HashMap<(String, String), Option<Fields>>> = Default::default();
+    static ZOD: std::cell::RefCell<std::collections::HashMap<String, Vec<(String, Vec<String>)>>> = Default::default();
+    static READS: std::cell::RefCell<std::collections::HashMap<String, std::rc::Rc<BTreeMap<String, Vec<(String, usize)>>>>> = Default::default();
+    static LIVE: std::cell::RefCell<std::collections::HashMap<String, std::rc::Rc<Live>>> = Default::default();
+}
+
+fn code_fields_memo(name: &str, text: &str, h: &str) -> Option<Fields> {
+    let key = (name.to_string(), h.to_string());
+    if let Some(v) = CODE_FIELDS.with(|c| c.borrow().get(&key).cloned()) {
+        return v;
+    }
+    let v = code_fields(name, text);
+    CODE_FIELDS.with(|c| c.borrow_mut().insert(key, v.clone()));
+    v
+}
+
+fn zod_memo(text: &str, h: &str, names: &[String]) -> Vec<(String, String)> {
+    let all = ZOD.with(|c| c.borrow().get(h).cloned()).unwrap_or_else(|| {
+        let v: Vec<(String, Vec<String>)> = crate::valuepairs::scan_zod(text)
+            .into_iter()
+            .filter_map(|d| match d.body {
+                crate::valuepairs::ShapeBody::Fields(f) => Some((d.name, f.into_iter().map(|(k, _)| k).collect())),
+                _ => None,
+            })
+            .collect();
+        ZOD.with(|c| c.borrow_mut().insert(h.to_string(), v.clone()));
+        v
+    });
+    let mut out = Vec::new();
+    for (n, ks) in all {
+        if names.contains(&n) {
+            out.extend(ks.into_iter().map(|k| (n.clone(), k)));
+        }
+    }
+    out
+}
