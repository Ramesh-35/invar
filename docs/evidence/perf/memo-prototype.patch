+/// PERF prototype: the whole live surface, memoized by the producer's (and
+/// code companion's) content hash, pointer and the named zod shapes.
+fn producer_surface_memo(
+    id: &str,
+    producer: &str,
+    pointer: Option<&str>,
+    code: Option<&str>,
+    resolver: &Resolver,
+    prov: &mut Vec<Fetched>,
+    zod_shapes: &[String],
+) -> Result<std::rc::Rc<Live>> {
+    let text = fetch_text(resolver, producer, prov)?;
+    let mut key = format!("{}|{}|{:?}|{}", artifact_name(producer), blake3::hash(text.as_bytes()).to_hex(), pointer, zod_shapes.join(","));
+    if let Some(c) = code {
+        let t = fetch_text(resolver, c, prov)?;
+        key.push_str(&format!("|{}|{}", artifact_name(c), blake3::hash(t.as_bytes()).to_hex()));
+    }
+    if let Some(v) = LIVE.with(|c| c.borrow().get(&key).cloned()) {
+        return Ok(v);
+    }
+    let v = std::rc::Rc::new(producer_surface(id, producer, pointer, code, resolver, &mut Vec::new(), zod_shapes)?);
+    LIVE.with(|c| c.borrow_mut().insert(key, v.clone()));
+    Ok(v)
+}
