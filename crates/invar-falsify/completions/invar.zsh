#compdef invar
# zsh completion for invar. Install: place as _invar in a $fpath dir,
# or `eval "$(invar completions zsh)"`. Generated by `invar completions zsh`.
_invar() {
  if (( CURRENT == 2 )); then
    compadd demo init check lock coverage dependents backtest verify-receipt receipt fix mcp completions run validate report verify audit replay help
    return
  fi
  case "$words[2]" in
    check)          compadd -- --config --ledger --ci --report-md --receipt --lock-signers --lock-principal --sample --contract --help;;
    lock)           compadd -- --config --update --lock-signers --lock-principal --sample --contract --help;;
    init)           compadd -- --root --force --stdout --help;;
    dependents)     compadd -- --locks --producer --format --help;;
    backtest)       compadd -- --config --contract --depth --format --help;;
    coverage)       compadd -- --config --contract --format --help;;
    fix)            compadd -- --config --suggest --help;;
    verify-receipt) compadd -- --config --artifacts --signers --principal --help;;
    completions)    compadd bash zsh fish;;
    *)              compadd -- --help;;
  esac
}
_invar "$@"
